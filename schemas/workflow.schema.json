            }
          },
          "required": [
            "id",
            "uses"
          ],
          "title": "Step: shell",
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "One entry of ``steps:`` (WORKFLOW-2, WORKFLOW-3).",
          "properties": {
            "apply": {
              "default": "review",
              "description": "Whether this step's ChangeSets apply automatically or wait for review. Ignored by steps that don't produce ChangeSets.",
              "enum": [
                "auto",
                "review"
              ],
              "title": "Apply",
              "type": "string"
            },
            "id": {
              "pattern": "^[a-z][a-z0-9_-]*$",
              "title": "Id",
              "type": "string"
            },
            "name": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Name"
            },
            "on_error": {
              "default": "stop",
              "enum": [
                "stop",
                "skip",
                "continue"
              ],
              "title": "On Error",
              "type": "string"
            },
            "uses": {
              "const": "tags.script",
              "title": "Uses"
            },
            "when": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Backend condition (a beets query).",
              "title": "When"
            },
            "with": {
              "$ref": "#/$defs/With_tags_script"
            }
          },
          "required": [
            "id",
            "uses"
          ],
          "title": "Step: tags.script",
          "type": "object"
        }
      ],
      "title": "Step"
    },
    "Triggers": {
      "additionalProperties": false,
      "description": "The ``on:`` block (WORKFLOW-13, F-TRIGGERS).",
      "properties": {
        "schedule": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Five-field cron expression or @daily-style alias.",
          "title": "Schedule"
        },
        "watch": {
          "anyOf": [
            {
              "$ref": "#/$defs/WatchTrigger"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "webhook": {
          "anyOf": [
            {
              "$ref": "#/$defs/WebhookTrigger"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "Triggers",
      "type": "object"
    },
    "VarDecl": {
      "additionalProperties": false,
      "description": "A declared workflow variable (WORKFLOW-7).",
      "properties": {
        "default": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Default"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        }
      },
      "title": "VarDecl",
      "type": "object"
    },
    "WatchTrigger": {
      "additionalProperties": false,
      "description": "``on.watch`` (F-TRIGGERS TRIGGERS-8 to -11).",
      "properties": {
        "path": {
          "description": "Folder to watch; each top-level folder in it is one input.",
          "title": "Path",
          "type": "string"
        },
        "poll": {
          "anyOf": [
            {
              "description": "<n>s, <n>m or <n>h",
              "pattern": "^[1-9][0-9]*[smh]$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Poll at this interval instead of using file events.",
          "title": "Poll"
        },
        "settle": {
          "default": "2m",
          "description": "How long an input must stay unchanged before a run starts.",
          "pattern": "^[1-9][0-9]*[smh]$",
          "title": "Settle",
          "type": "string"
        }
      },
      "required": [
        "path"
      ],
      "title": "WatchTrigger",
      "type": "object"
    },
    "WebhookTrigger": {
      "additionalProperties": false,
      "description": "``on.webhook`` (F-TRIGGERS TRIGGERS-15 to -18).",
      "properties": {
        "input": {
          "description": "Dotted path to the input path in the JSON body, e.g. trackFiles.0.path.",
          "pattern": "^[A-Za-z0-9_-]+(\\.[A-Za-z0-9_-]+)*$",
          "title": "Input",
          "type": "string"
        },
        "name": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
          "title": "Name",
          "type": "string"
        },
        "within": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Inputs must lie inside this folder (default: on.watch.path).",
          "title": "Within"
        }
      },
      "required": [
        "name",
        "input"
      ],
      "title": "WebhookTrigger",
      "type": "object"
    },
    "With_beets_command": {
      "additionalProperties": false,
      "properties": {
        "args": {
          "description": "Options and arguments for the subcommand, e.g. [-a]. beets templates ($path, %if{}) reach beets unchanged. The run's albums are added as the query.",
          "items": {
            "type": "string"
          },
          "title": "Args",
          "type": "array"
        },
        "command": {
          "description": "One beet subcommand, e.g. move, replaygain, fetchart, mbsync (https://beets.readthedocs.io/en/stable/reference/cli.html). Options go in args.",
          "pattern": "^[a-z][a-z0-9_-]*$",
          "title": "Command",
          "type": "string"
        },
        "timeout": {
          "default": "1h",
          "description": "Stop the command after this long",
          "pattern": "^(\\d+[dhms])+$",
          "title": "Timeout",
          "type": "string"
        }
      },
      "required": [
        "command"
      ],
      "title": "BeetsCommandParams",
      "type": "object"
    },
    "With_beets_import": {
      "additionalProperties": false,
      "properties": {
        "decision_timeout": {
          "anyOf": [
            {
              "description": "A duration: whole numbers with d, h, m or s, e.g. 30m, 12h, 3d, 1d12h",
              "pattern": "^(\\d+[dhms])+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Decide an unanswered import decision with on_timeout after this long (IMPORT-UI-10); default: wait indefinitely",
          "title": "Decision Timeout"
        },
        "mode": {
          "default": "auto",
          "description": "quiet: strong matches or quiet_fallback; auto: strong matches, the rest wait as import decisions; interactive: every album waits (F-IMPORT-UI)",
          "enum": [
            "quiet",
            "auto",
            "interactive"
          ],
          "title": "Mode",
          "type": "string"
        },
        "on_timeout": {
          "default": "skip",
          "enum": [
            "skip",
            "asis"
          ],
          "title": "On Timeout",
          "type": "string"
        },
        "options": {
          "$ref": "#/$defs/With_beets_import__ImporterOptions"
        },
        "path": {
          "description": "Folder to import",
          "title": "Path",
          "type": "string"
        },
        "set": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Fields stored on every imported album and its items (beets set_fields)",
          "title": "Set",
          "type": "object"
        }
      },
      "required": [
        "path"
      ],
      "title": "BeetsImportParams",
      "type": "object"
    },
    "With_beets_import__ImporterOptions": {
      "additionalProperties": false,
      "description": "beets importer options a step may override for its own import (BEETS-IMPORT-4).\nUnset options come from the user's beets config. See\nhttps://beets.readthedocs.io/en/stable/reference/config.html#importer-options",
      "properties": {
        "autotag": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Autotag"
        },
        "copy": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Copy"
        },
        "duplicate_action": {
          "anyOf": [
            {
              "enum": [
                "skip",
                "keep",
                "remove",
                "merge",
                "upgrade",
                "ask"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "'ask' makes a duplicate an import decision in modes auto/interactive (IMPORT-UI-3); quiet mode skips it",
          "title": "Duplicate Action"
        },
        "hardlink": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Hardlink"
        },
        "incremental": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Incremental"
        },
        "link": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Link"
        },
        "move": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Move"
        },
        "quiet_fallback": {
          "anyOf": [
            {
              "enum": [
                "skip",
                "asis"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quiet Fallback"
        },
        "reflink": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "const": "auto",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reflink"
        },
        "write": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Write"
        }
      },
      "title": "ImporterOptions",
      "type": "object"
    },
    "With_review": {
      "additionalProperties": false,
      "properties": {
        "message": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Shown for each album: a beets template, e.g. 'Check $albumartist - $album before the files move' (https://beets.readthedocs.io/en/stable/reference/pathformat.html)",
          "title": "Message"
        },
        "on_reject": {
          "default": "stop",
          "description": "On reject, stop the run (stop) or also undo its applied tag changes (undo). Imports are never undone.",
          "enum": [
            "stop",
            "undo"
          ],
          "title": "On Reject",
          "type": "string"
        },
        "on_timeout": {
          "anyOf": [
            {
              "enum": [
                "continue",
                "reject"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The decision taken once timeout passes (default reject)",
          "title": "On Timeout"
        },
        "show": {
          "description": "Fields to show for each album",
          "items": {
            "type": "string"
          },
          "title": "Show",
          "type": "array"
        },
        "timeout": {
          "anyOf": [
            {
              "description": "A duration: whole numbers with d, h, m or s, e.g. 30m, 12h, 3d, 1d12h",
              "pattern": "^(\\d+[dhms])+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Decide automatically after this long, e.g. 3d",
          "title": "Timeout"
        }
      },
      "title": "ReviewParams",
      "type": "object"
    },
    "With_shell": {
      "additionalProperties": false,
      "properties": {
        "cwd": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Working directory (templated)",
          "title": "Cwd"
        },
        "emits": {
          "default": "none",
          "description": "none: stdout goes to the run log. changes: stdout is one JSON ChangeSetProposal (schemas/changeset-proposal.schema.json).",
          "enum": [
            "none",
            "changes"
          ],
          "title": "Emits",
          "type": "string"
        },
        "env": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Extra variables",
          "title": "Env",
          "type": "object"
        },
        "per": {
          "default": "album",
          "enum": [
            "run",
            "album",
            "item"
          ],
          "title": "Per",
          "type": "string"
        },
        "run": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "string"
            }
          ],
          "description": "Command as an argv list, or a string run by /bin/sh -c (needs shell: true)",
          "title": "Run"
        },
        "secrets": {
          "description": "Profile secrets to expose as RIFFERR_SECRET_<NAME>",
          "items": {
            "type": "string"
          },
          "title": "Secrets",
          "type": "array"
        },
        "shell": {
          "default": false,
          "description": "Run a string command through /bin/sh -c",
          "title": "Shell",
          "type": "boolean"
        },
        "timeout": {
          "default": 600,
          "description": "Seconds before the command is stopped",
          "exclusiveMinimum": 0,
          "title": "Timeout",
          "type": "integer"
        }
      },
      "required": [
        "run"
      ],
      "title": "ShellParams",
      "type": "object"
    },
    "With_tags_script": {
      "additionalProperties": false,
      "description": "``with:`` of a ``tags.script`` step. Step parameters override the file's.",
      "properties": {
        "actions": {
          "anyOf": [
            {
              "items": {
                "oneOf": [
                  {
                    "$ref": "#/$defs/With_tags_script__SetAction"
                  },
                  {
                    "$ref": "#/$defs/With_tags_script__CopyAction"
                  },
                  {
                    "$ref": "#/$defs/With_tags_script__MoveAction"
                  },
                  {
                    "$ref": "#/$defs/With_tags_script__ReplaceAction"
                  },
                  {
                    "$ref": "#/$defs/With_tags_script__SplitAction"
                  },
                  {
                    "$ref": "#/$defs/With_tags_script__JoinAction"
                  },
                  {
                    "$ref": "#/$defs/With_tags_script__CaseAction"
                  },
                  {
                    "$ref": "#/$defs/With_tags_script__FromFilenameAction"
                  },
                  {
                    "$ref": "#/$defs/With_tags_script__DeleteAction"
                  },
                  {
                    "$ref": "#/$defs/With_tags_script__AppendUniqueAction"
                  }
                ]
              },
              "minItems": 1,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Actions"
        },
        "idempotence": {
          "anyOf": [
            {
              "enum": [
                "warn",
                "fail",
                "off"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Idempotence"
        },
        "scope": {
          "anyOf": [
            {
              "enum": [
                "album",
                "item"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scope"
        },
        "script": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Script file, relative to the profile's scripts/ folder",
          "title": "Script"
        }
      },
      "title": "TagScriptParams",
      "type": "object"
    },
    "With_tags_script__AppendSpec": {
      "additionalProperties": false,
      "properties": {
        "field": {
          "title": "Field",
          "type": "string"
        },
        "values": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Values",
          "type": "array"
        }
      },
      "required": [
        "field",
        "values"
      ],
      "title": "AppendSpec",
