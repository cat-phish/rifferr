{
  "$defs": {
    "Step": {
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "One entry of ``steps:`` (WORKFLOW-2, WORKFLOW-3).",
          "properties": {
            "apply": {
              "default": "review",
              "description": "Whether this step's ChangeSets apply automatically or wait for review. Ignored by steps that don't produce ChangeSets.",
              "enum": [
                "auto",
                "review"
              ],
              "title": "Apply",
              "type": "string"
            },
            "id": {
              "pattern": "^[a-z][a-z0-9_-]*$",
              "title": "Id",
              "type": "string"
            },
            "name": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Name"
            },
            "on_error": {
              "default": "stop",
              "enum": [
                "stop",
                "skip",
                "continue"
              ],
              "title": "On Error",
              "type": "string"
            },
            "uses": {
              "const": "beets.command",
              "title": "Uses"
            },
            "when": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Backend condition (a beets query).",
              "title": "When"
            },
            "with": {
              "$ref": "#/$defs/With_beets_command"
            }
          },
          "required": [
            "id",
            "uses"
          ],
          "title": "Step: beets.command",
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "One entry of ``steps:`` (WORKFLOW-2, WORKFLOW-3).",
          "properties": {
            "apply": {
              "default": "review",
              "description": "Whether this step's ChangeSets apply automatically or wait for review. Ignored by steps that don't produce ChangeSets.",
              "enum": [
                "auto",
                "review"
              ],
              "title": "Apply",
              "type": "string"
            },
            "id": {
              "pattern": "^[a-z][a-z0-9_-]*$",
              "title": "Id",
              "type": "string"
            },
            "name": {
              "anyOf": [
                {
