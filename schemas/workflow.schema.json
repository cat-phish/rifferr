{
  "$defs": {
    "Step": {
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "One entry of ``steps:`` (WORKFLOW-2, WORKFLOW-3).",
          "properties": {
            "apply": {
              "default": "review",
              "description": "Whether this step's ChangeSets apply automatically or wait for review. Ignored by steps that don't produce ChangeSets.",
              "enum": [
                "auto",
                "review"
              ],
              "title": "Apply",
              "type": "string"
            },
            "id": {
              "pattern": "^[a-z][a-z0-9_-]*$",
              "title": "Id",
              "type": "string"
            },
            "name": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Name"
            },
            "on_error": {
              "default": "stop",
              "enum": [
                "stop",
                "skip",
                "continue"
              ],
              "title": "On Error",
              "type": "string"
            },
            "uses": {
              "const": "beets.import",
              "title": "Uses"
            },
            "when": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Backend condition (a beets query).",
              "title": "When"
            },
            "with": {
              "$ref": "#/$defs/With_beets_import"
            }
          },
          "required": [
            "id",
            "uses"
          ],
          "title": "Step: beets.import",
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "One entry of ``steps:`` (WORKFLOW-2, WORKFLOW-3).",
          "properties": {
            "apply": {
              "default": "review",
              "description": "Whether this step's ChangeSets apply automatically or wait for review. Ignored by steps that don't produce ChangeSets.",
              "enum": [
                "auto",
                "review"
              ],
              "title": "Apply",
              "type": "string"
            },
            "id": {
              "pattern": "^[a-z][a-z0-9_-]*$",
              "title": "Id",
              "type": "string"
            },
            "name": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Name"
            },
            "on_error": {
              "default": "stop",
              "enum": [
                "stop",
                "skip",
                "continue"
              ],
              "title": "On Error",
              "type": "string"
            },
            "uses": {
              "const": "shell",
              "title": "Uses"
            },
            "when": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Backend condition (a beets query).",
              "title": "When"
            },
            "with": {
              "$ref": "#/$defs/With_shell"
            }
          },
          "required": [
            "id",
            "uses"
          ],
          "title": "Step: shell",
          "type": "object"
        }
      ],
      "title": "Step"
    },
    "Triggers": {
      "additionalProperties": false,
      "description": "The ``on:`` block. Parsed and validated; not acted on until F-TRIGGERS (WORKFLOW-13).",
      "properties": {
        "schedule": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "cron expression",
          "title": "Schedule"
        },
        "watch": {
          "anyOf": [
            {
              "$ref": "#/$defs/WatchTrigger"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "webhook": {
          "anyOf": [
            {
              "$ref": "#/$defs/WebhookTrigger"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "Triggers",
      "type": "object"
    },
    "VarDecl": {
      "additionalProperties": false,
      "description": "A declared workflow variable (WORKFLOW-7).",
      "properties": {
        "default": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Default"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        }
      },
      "title": "VarDecl",
      "type": "object"
    },
    "WatchTrigger": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "settle": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Settle"
        }
      },
      "required": [
        "path"
      ],
      "title": "WatchTrigger",
      "type": "object"
    },
    "WebhookTrigger": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "title": "WebhookTrigger",
      "type": "object"
    },
    "With_beets_import": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "const": "quiet",
          "default": "quiet",
          "title": "Mode",
          "type": "string"
        },
        "options": {
          "$ref": "#/$defs/With_beets_import__ImporterOptions"
        },
        "path": {
          "description": "Folder to import",
          "title": "Path",
          "type": "string"
        },
        "set": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Fields stored on every imported album and its items (beets set_fields)",
          "title": "Set",
          "type": "object"
        }
      },
      "required": [
        "path"
      ],
      "title": "BeetsImportParams",
      "type": "object"
    },
    "With_beets_import__ImporterOptions": {
      "additionalProperties": false,
      "description": "beets importer options a step may override for its own import (BEETS-IMPORT-4).\nUnset options come from the user's beets config. See\nhttps://beets.readthedocs.io/en/stable/reference/config.html#importer-options",
      "properties": {
        "autotag": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Autotag"
        },
        "copy": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Copy"
        },
        "duplicate_action": {
          "anyOf": [
            {
              "enum": [
                "skip",
                "keep",
                "remove",
                "merge",
                "upgrade"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duplicate Action"
        },
        "hardlink": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Hardlink"
        },
        "incremental": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Incremental"
        },
        "link": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Link"
        },
        "move": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Move"
        },
        "quiet_fallback": {
          "anyOf": [
            {
              "enum": [
                "skip",
                "asis"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quiet Fallback"
        },
        "reflink": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "const": "auto",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reflink"
        },
        "write": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Write"
        }
      },
      "title": "ImporterOptions",
      "type": "object"
    },
    "With_shell": {
      "additionalProperties": false,
      "properties": {
        "cwd": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Working directory (templated)",
          "title": "Cwd"
        },
        "emits": {
          "const": "none",
          "default": "none",
          "title": "Emits",
          "type": "string"
        },
        "env": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Extra variables",
          "title": "Env",
          "type": "object"
        },
        "per": {
          "default": "album",
          "enum": [
            "run",
            "album",
            "item"
          ],
          "title": "Per",
          "type": "string"
        },
        "run": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "string"
            }
          ],
          "description": "Command as an argv list, or a string run by /bin/sh -c (needs shell: true)",
          "title": "Run"
        },
        "secrets": {
          "description": "Profile secrets to expose as RIFFERR_SECRET_<NAME>",
          "items": {
            "type": "string"
          },
          "title": "Secrets",
          "type": "array"
        },
        "shell": {
          "default": false,
          "description": "Run a string command through /bin/sh -c",
          "title": "Shell",
          "type": "boolean"
        },
        "timeout": {
          "default": 600,
          "description": "Seconds before the command is stopped",
          "exclusiveMinimum": 0,
          "title": "Timeout",
          "type": "integer"
        }
      },
      "required": [
        "run"
      ],
      "title": "ShellParams",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A workflow file (WORKFLOW-1).",
  "properties": {
    "description": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Description"
    },
    "name": {
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "on": {
      "anyOf": [
        {
          "$ref": "#/$defs/Triggers"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "steps": {
      "items": {
        "$ref": "#/$defs/Step"
      },
      "minItems": 1,
      "title": "Steps",
      "type": "array"
    },
    "vars": {
      "additionalProperties": {
        "$ref": "#/$defs/VarDecl"
      },
      "title": "Vars",
      "type": "object"
    }
  },
  "required": [
    "name",
    "steps"
  ],
  "title": "Rifferr workflow",
  "type": "object"
}
