            }
          },
          "required": [
            "id",
            "uses"
          ],
          "title": "Step: beets.import",
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "One entry of ``steps:`` (WORKFLOW-2, WORKFLOW-3).",
          "properties": {
            "apply": {
              "default": "review",
