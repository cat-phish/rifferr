# Copy to .env for local development. .env is git-ignored; never commit real values.
# Native installs should prefer the OS keyring; env vars are for Docker/CI.
# Secrets must never appear in workflow files, logs or events.

RIFFERR_PROFILE=dev

# AI providers (optional)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Cover providers (optional)
DISCOGS_TOKEN=
FANARTTV_API_KEY=
LASTFM_API_KEY=
